{
  "name": "certificate-generator",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node --watch tools/serve.js",
    "build": "node tools/build.js",
    "generate": "node index.js",
    "test": "node --test tests/*.test.js",
    "coordinate-picker": "node tools/serve.js",
    "dashboard": "node tools/serve.js",
    "test:browser": "playwright test",
    "format": "prettier --write public/*.html public/*.css public/*.js public/lib/*.js tools/*.js index.js tests package.json config.json vercel.json playwright.config.js README.md VERCEL_DEPLOY.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A simple certificate maker with a browser workspace and a shared PDF renderer.",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
